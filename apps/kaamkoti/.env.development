# DEV values, public in the repository; the stack is infra/compose.dev.yml. Production values live on the server.
DATABASE_URL=postgres://kaamkoti_app:kaamkoti_app@127.0.0.1:45442/kaamkoti
APP_ORIGIN=http://127.0.0.1:45450
# The same dev server under another host name, so the customer cookie and the member cookie stay apart.
PUBLIC_ORIGIN=http://localhost:45450
IDENTITY_ORIGIN=http://127.0.0.1:45443
PLATFORM_INTERNAL_URL=http://127.0.0.1:45443
SIGN_IN_CLIENT_SECRET=dev-only-kaamkoti-sign-in-secret-public-in-repo
# The worker signs outbox deliveries with it; matches `kaamkoti` in platform's SERVICE_CLIENTS.
SERVICE_SECRET=dev-only-kaamkoti-service-secret-public-in-repo
REDIS_URL=redis://127.0.0.1:45444
# The web key: read and write on kaamkoti-private only. scripts/stack.ts imports it into Garage from this file.
S3_ENDPOINT=http://127.0.0.1:45447
S3_PUBLIC_ENDPOINT=http://127.0.0.1:45447
S3_REGION=garage
S3_ACCESS_KEY_ID=GK6b61616d6b6f74692d776562
S3_SECRET_ACCESS_KEY=6b61616d6b6f74692d7765622d6465762d6f6e6c792d6e6f742d736563726574
# Seals the Razorpay keys owners connect in development; production's own key is on the server.
PAYMENTS_SEALING_KEY=9GBTP4jq23z2RCkR/aJo3L8QkHCVbf9C62AtFIhVE4Y=
# No real Razorpay in development: the browser check serves a stand-in here (scripts/browser-check.ts).
RAZORPAY_API=http://127.0.0.1:45451
